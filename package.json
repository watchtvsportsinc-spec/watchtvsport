{
  "name": "watchtvsport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:imports && npm run test:data && npm run test:seed && npm run test:supabase-apply && npm run test:quality",
    "test:imports": "node --test scripts/import-validation.test.mjs",
    "test:data": "node --test scripts/world-cup-archive-import.test.mjs scripts/public-events-schema.test.mjs",
    "test:seed": "node --test scripts/export-v2-multisport-seed.test.mjs",
    "test:supabase-apply": "node --test scripts/apply-v2-seed-to-supabase.test.mjs",
    "test:quality": "node --test scripts/v2-quality-audit.test.mjs scripts/competition-architecture.test.mjs scripts/sport-competition-product-ux.test.mjs",
    "export:world-cup": "node scripts/export-world-cup-archive.mjs",
    "export:v2-seed": "node scripts/export-v2-multisport-seed.mjs",
    "plan:v2-seed": "node scripts/apply-v2-seed-to-supabase.mjs",
    "apply:v2-seed": "node scripts/apply-v2-seed-to-supabase.mjs --apply",
    "validate:import": "node scripts/validate-import.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jiti": "2.6.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
